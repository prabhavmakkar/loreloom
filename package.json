{
  "name": "loreloom",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "start": "npm run build -w @loreloom/web && tsx packages/server/src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "mcp": "tsx packages/mcp/src/index.ts",
    "dev": "concurrently -P -k -n server,web -c blue,green \"tsx watch packages/server/src/cli.ts --no-open {@}\" \"npm run dev -w @loreloom/web\" --"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
